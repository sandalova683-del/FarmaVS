{
  "name": "formulavs",
  "version": "4.0.0",
  "private": true,
  "description": "FormulaVS wellness tracker with Apple Health and Android Health Connect integration",
  "scripts": {
    "sync": "npx cap sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "build:web": "node scripts/check-web.js",
    "doctor": "npx cap doctor",
    "setup:native": "node scripts/setup-native.mjs",
    "verify": "npm run build:web && npm run doctor"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  }
}
